# ── API ───────────────────────────────────────────────────────────────────────
# Backend URL. Set this to your deployed backend in staging/production.
VITE_API_BASE_URL=http://localhost:8000

# ── Auth ─────────────────────────────────────────────────────────────────────
# Fallback token used when localStorage has no "token" key.
# For pilot/dev: set to "dev-token" to match AUTH_MODE=dev on the backend.
# For production: leave empty — tokens come from your OIDC login flow.
VITE_AUTH_TOKEN=dev-token

# ── Public marketing site (/site) ─────────────────────────────────────────────
# Analytics provider for the marketing pages. Leave "none" (or unset) to keep a
# no-op abstraction with NO third-party calls and NO keys in source.
# Supported: none | plausible | gtag  (load the provider script yourself in
# index.html; the site only calls window.plausible / window.gtag if present).
VITE_ANALYTICS_PROVIDER=none

# Secure endpoint that receives contact/demo-request submissions as JSON.
# Leave EMPTY to run the contact form in safe MOCK mode (no network, no relay).
# Point at your own serverless function / form service; never embed a mail
# credential in the frontend. See docs/marketing/DEPLOYMENT_GUIDE.md.
VITE_CONTACT_ENDPOINT=

# Optional produced explainer video. When set, the /video page plays this real
# MP4 (with captions) instead of the built-in animated storyboard. Point it at
# your own hosted, PHI-safe footage (e.g. a technician-borescope walkthrough).
# Leave EMPTY to keep the self-playing synthetic storyboard.
VITE_EXPLAINER_VIDEO_URL=
# Optional poster image shown before the produced video plays.
VITE_EXPLAINER_POSTER_URL=
